[
  [
    "LOG",
    "Setup (Typhoid Mary): Put Disturbed Psyche environment and Establish Trust side scheme into play"
  ],
  [
    "VAR",
    "$PSYCHE",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "aeb16733-592d-54c3-a592-02c7be4f4edc"
      ]
    ]
  ],
  [
    "COND",
    [
      "DEFINED",
      "$PSYCHE"
    ],
    [
      [
        "MOVE_CARD",
        "$PSYCHE.id",
        "sharedVillain",
        -1
      ],
      [
        "SET",
        "/cardById/$PSYCHE.id/currentSide",
        "A"
      ]
    ]
  ],
  [
    "VAR",
    "$TRUST",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "238c57b9-9746-5cd1-bb38-982b67cd6a68"
      ]
    ]
  ],
  [
    "COND",
    [
      "DEFINED",
      "$TRUST"
    ],
    [
      [
        "MOVE_CARD",
        "$TRUST.id",
        "sharedVillain",
        -1
      ],
      [
        "SET",
        "/cardById/$TRUST.id/currentSide",
        "A"
      ],
      [
        "SET_SCHEME_STARTING_THREAT",
        "$TRUST.id"
      ],
      [
        "COND",
        [
          "EQUAL",
          "$GAME.mode",
          "expert"
        ],
        [
          [
            "INCREASE_VAL",
            "/cardById/$TRUST.id/tokens/threat",
            [
              "MULTIPLY",
              3,
              "$GAME.numPlayers"
            ]
          ],
          [
            "LOG",
            "Setup (Typhoid Mary Expert): Added 3 hinder threat per player to Establish Trust"
          ]
        ]
      ]
    ]
  ],
  [
    "VAR",
    "$TM_STAGE",
    [
      "COND",
      [
        "EQUAL",
        "$GAME.mode",
        "expert"
      ],
      [
        "ONE_CARD",
        "$CARD",
        [
          "AND",
          [
            "EQUAL",
            "$CARD.sides.A.name",
            "Typhoid Mary"
          ],
          [
            "EQUAL",
            "$CARD.sides.A.stage",
            "II"
          ]
        ]
      ],
      true,
      [
        "ONE_CARD",
        "$CARD",
        [
          "AND",
          [
            "EQUAL",
            "$CARD.sides.A.name",
            "Typhoid Mary"
          ],
          [
            "EQUAL",
            "$CARD.sides.A.stage",
            "I"
          ]
        ]
      ]
    ]
  ],
  [
    "COND",
    [
      "DEFINED",
      "$TM_STAGE"
    ],
    [
      [
        "VAR",
        "$RAND_VAL",
        [
          "RANDOM_INT",
          1,
          2
        ]
      ],
      [
        "COND",
        [
          "EQUAL",
          "$RAND_VAL",
          2
        ],
        [
          [
            "SET",
            "/cardById/$TM_STAGE.id/currentSide",
            "B"
          ],
          [
            "LOG",
            "Setup: Typhoid Mary starts on Bloody Mary side."
          ]
        ],
        true,
        [
          [
            "SET",
            "/cardById/$TM_STAGE.id/currentSide",
            "A"
          ],
          [
            "LOG",
            "Setup: Typhoid Mary starts on Typhoid Mary side."
          ]
        ]
      ]
    ]
  ],
  [
    "SHUFFLE_GROUP",
    "sharedEncounterDeck"
  ]
]