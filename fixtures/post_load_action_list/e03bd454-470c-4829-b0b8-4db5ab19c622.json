[
  [
    "ACTION_LIST",
    "multipleDoubleSidedVillains"
  ],
  [
    "LOG",
    "Setup: Put \"Routed\" environment into play"
  ],
  [
    "DEFINE",
    "$ROUTED",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "90f790ad-16f7-5297-a6b1-cfb30423fb8e"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$ROUTED.id",
    "sharedVillain",
    -1
  ],
  [
    "COND",
    [
      "EQUAL",
      "$GAME.mode",
      "expert"
    ],
    [
      [
        "SET",
        "/cardById/$ROUTED.id/currentSide",
        "B"
      ]
    ],
    true,
    [
      [
        "SET",
        "/cardById/$ROUTED.id/currentSide",
        "A"
      ]
    ]
  ],
  [
    "LOG",
    "Setup: Set aside \"Hide!\" and Morlock allies"
  ],
  [
    "DEFINE",
    "$HIDE",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "dd1a46cc-2e27-512e-89e8-f205d3a9de42"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$HIDE.id",
    "sharedOutOfPlay",
    -1
  ],
  [
    "SET",
    "/cardById/$HIDE.id/currentSide",
    "A"
  ],
  [
    "FOR_EACH_VAL",
    "$CARD_ID",
    "$GAME.groupById.sharedEncounterDeck.parentCardIds",
    [
      [
        "VAR",
        "$CARD",
        "$GAME.cardById.$CARD_ID"
      ],
      [
        "COND",
        [
          "OR",
          [
            "EQUAL",
            "$CARD.databaseId",
            "80801cb6-b122-54c0-ad81-be11b67037f0"
          ],
          [
            "EQUAL",
            "$CARD.sides.A.name",
            "Morlock"
          ]
        ],
        [
          [
            "MOVE_CARD",
            "$CARD_ID",
            "sharedOutOfPlay",
            -1
          ],
          [
            "SET",
            "/cardById/$CARD_ID/currentSide",
            "A"
          ]
        ]
      ]
    ]
  ]
]