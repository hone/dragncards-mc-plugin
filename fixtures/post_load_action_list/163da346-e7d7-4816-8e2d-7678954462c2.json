[
  [
    "LOG",
    "Setup: Put Hope Summers into play under the first player's control"
  ],
  [
    "DEFINE",
    "$HOPE",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "e9d08f29-af52-590d-bc2c-37498c3fc919"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$HOPE.id",
    "player1Play1",
    -1
  ],
  [
    "SET",
    "/cardById/$HOPE.id/currentSide",
    "A"
  ],
  [
    "LOG",
    "Setup: Set aside Flight, Super Strength, and Telepathy encounter sets"
  ],
  [
    "FOR_EACH_VAL",
    "$CARD_ID",
    "$GAME.groupById.sharedEncounterDeck.parentCardIds",
    [
      [
        "VAR",
        "$CARD",
        "$GAME.cardById.$CARD_ID"
      ],
      [
        "COND",
        [
          "OR",
          [
            "EQUAL",
            "$CARD.sides.A.set",
            "Flight"
          ],
          [
            "EQUAL",
            "$CARD.sides.A.set",
            "Super Strength"
          ],
          [
            "EQUAL",
            "$CARD.sides.A.set",
            "Telepathy"
          ]
        ],
        [
          [
            "MOVE_CARD",
            "$CARD_ID",
            "sharedOutOfPlay",
            -1
          ],
          [
            "SET",
            "/cardById/$CARD_ID/currentSide",
            "A"
          ]
        ]
      ]
    ]
  ],
  [
    "LOG",
    "Setup (Sinister Intent 1B): Shuffle Stage 2 schemes and remove 1 random Stage 2 from the game"
  ],
  [
    "SHUFFLE_GROUP",
    "sharedMainSchemeDeck"
  ],
  [
    "DEFINE",
    "$REMOVED_STAGE_2",
    [
      "ONE_CARD",
      "$CARD",
      [
        "AND",
        [
          "EQUAL",
          "$CARD.groupId",
          "sharedMainSchemeDeck"
        ],
        [
          "EQUAL",
          "$CARD.sides.A.stage",
          "2A"
        ]
      ]
    ]
  ],
  [
    "COND",
    [
      "DEFINED",
      "$REMOVED_STAGE_2"
    ],
    [
      [
        "MOVE_CARD",
        "$REMOVED_STAGE_2.id",
        "sharedMainSchemeDiscard",
        -1
      ],
      [
        "SET",
        "/cardById/$REMOVED_STAGE_2.id/currentSide",
        "A"
      ],
      [
        "LOG",
        "Setup (1B): Removed {{$REMOVED_STAGE_2.sides.B.name}} (Stage 2) to the main scheme discard pile."
      ]
    ]
  ],
  [
    "SHUFFLE_GROUP",
    "sharedMainSchemeDeck"
  ],
  [
    "DEFINE",
    "$STAGE_3",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "6ab3193d-15d6-5910-9ba5-ffdda2605f2e"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$STAGE_3.id",
    "sharedMainSchemeDeck",
    -1
  ],
  [
    "LOG",
    "Setup (Sinister Experiment 2B): Press Shift+A on the active Stage 2B main scheme to resolve its When Revealed ability."
  ]
]