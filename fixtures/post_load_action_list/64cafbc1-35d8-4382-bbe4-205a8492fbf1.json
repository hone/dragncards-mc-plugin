[
  [
    "LOG",
    "Setup: Set Future of Despair side scheme aside in Out of Play"
  ],
  [
    "DEFINE",
    "$FUTURE_DESPAIR",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "e86ece4d-c6ed-5a47-a31e-4596c954b860"
      ]
    ]
  ],
  [
    "COND",
    [
      "DEFINED",
      "$FUTURE_DESPAIR"
    ],
    [
      [
        "MOVE_CARD",
        "$FUTURE_DESPAIR.id",
        "sharedOutOfPlay",
        -1
      ],
      [
        "SET",
        "/cardById/$FUTURE_DESPAIR.id/currentSide",
        "A"
      ]
    ]
  ],
  [
    "LOG",
    "Setup: Gather Hypnotic Gaze attachments to Out of Play"
  ],
  [
    "FOR_EACH_VAL",
    "$CARD_ID",
    "$GAME.groupById.sharedEncounterDeck.parentCardIds",
    [
      [
        "VAR",
        "$CARD",
        "$GAME.cardById.$CARD_ID"
      ],
      [
        "COND",
        [
          "IN_STRING",
          "$CARD.sides.A.name",
          "Hypnotic Gaze"
        ],
        [
          [
            "MOVE_CARD",
            "$CARD_ID",
            "sharedOutOfPlay",
            -1
          ],
          [
            "SET",
            "/cardById/$CARD_ID/currentSide",
            "A"
          ]
        ]
      ]
    ]
  ],
  [
    "LOG",
    "Setup: Attach a random Hypnotic Gaze to each identity"
  ],
  [
    "SHUFFLE_GROUP",
    "sharedOutOfPlay"
  ],
  [
    "FOR_EACH_VAL",
    "$PLAYER_I",
    "$PLAYER_ORDER",
    [
      [
        "DEFINE",
        "$GAZE",
        [
          "ONE_CARD",
          "$CARD",
          [
            "AND",
            [
              "EQUAL",
              "$CARD.groupId",
              "sharedOutOfPlay"
            ],
            [
              "IN_STRING",
              "$CARD.sides.A.name",
              "Hypnotic Gaze"
            ]
          ]
        ]
      ],
      [
        "COND",
        [
          "DEFINED",
          "$GAZE"
        ],
        [
          [
            "MOVE_CARD",
            "$GAZE.id",
            "{{$PLAYER_I}}Play1",
            -1
          ],
          [
            "SET",
            "/cardById/$GAZE.id/currentSide",
            "A"
          ],
          [
            "LOG",
            "Setup: Attached Hypnotic Gaze to {{$GAME.playerInfo.$PLAYER_I.alias}}'s play area."
          ]
        ]
      ]
    ]
  ],
  [
    "SHUFFLE_GROUP",
    "sharedEncounterDeck"
  ]
]