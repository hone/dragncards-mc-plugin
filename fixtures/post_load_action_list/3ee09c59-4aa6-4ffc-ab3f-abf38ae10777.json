[
  [
    "LOG",
    "Setup (Spider-Woman): Put Self-Propelled Glide side scheme into play"
  ],
  [
    "DEFINE",
    "$GLIDE",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "dc740c13-dc3d-5281-ab1e-e8d1f93b13c5"
      ]
    ]
  ],
  [
    "COND",
    [
      "DEFINED",
      "$GLIDE"
    ],
    [
      [
        "MOVE_CARD",
        "$GLIDE.id",
        "sharedVillain",
        -1
      ],
      [
        "SET",
        "/cardById/$GLIDE.id/currentSide",
        "A"
      ]
    ]
  ],
  [
    "LOG",
    "Setup (Spider-Woman): Attach Finesse to Spider-Woman"
  ],
  [
    "VAR",
    "$ACTIVE_LEADER_ID",
    "$GAME.groupById.sharedVillain.parentCardIds.[0]"
  ],
  [
    "DEFINE",
    "$FINESSE",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "8dff2edf-2170-59e0-b16d-3cd60403fb64"
      ]
    ]
  ],
  [
    "COND",
    [
      "DEFINED",
      "$FINESSE"
    ],
    [
      [
        "ATTACH_CARD",
        "$FINESSE.id",
        "$ACTIVE_LEADER_ID",
        {
          "combine": "left"
        }
      ],
      [
        "SET",
        "/cardById/$FINESSE.id/currentSide",
        "A"
      ],
      [
        "LOG",
        "Setup: Attached Finesse to Spider-Woman."
      ]
    ]
  ],
  [
    "COND",
    [
      "GREATER_THAN",
      "$GAME.numPlayers",
      1
    ],
    [
      [
        "VAR",
        "$HINDER_THREAT",
        [
          "MULTIPLY",
          2,
          "$GAME.numPlayers"
        ]
      ],
      [
        "VAR",
        "$MAIN_SCHEME_ID",
        "$GAME.groupById.sharedMainScheme.parentCardIds.[0]"
      ],
      [
        "COND",
        [
          "DEFINED",
          "$MAIN_SCHEME_ID"
        ],
        [
          [
            "INCREASE_VAL",
            "/cardById/$MAIN_SCHEME_ID/tokens/threat",
            "$HINDER_THREAT"
          ],
          [
            "LOG",
            "Setup: Added {{$HINDER_THREAT}} hinder threat to main scheme."
          ]
        ]
      ]
    ]
  ],
  [
    "SHUFFLE_GROUP",
    "sharedEncounterDeck"
  ]
]