[
  [
    "ACTION_LIST",
    "multipleDoubleSidedVillains"
  ],
  [
    "VAR",
    "$STARTING_VILLAIN_ID",
    "$GAME.groupById.sharedVillain.parentCardIds.[0]"
  ],
  [
    "VAR",
    "$VILLAIN_NAME",
    "$GAME.cardById.$STARTING_VILLAIN_ID.currentFace.name"
  ],
  [
    "LOG",
    "Setup: Remove matching minion ({{$VILLAIN_NAME}}) from the encounter deck"
  ],
  [
    "FOR_EACH_VAL",
    "$CARD_ID",
    "$GAME.groupById.sharedEncounterDeck.parentCardIds",
    [
      [
        "VAR",
        "$CARD",
        "$GAME.cardById.$CARD_ID"
      ],
      [
        "COND",
        [
          "AND",
          [
            "EQUAL",
            "$CARD.sides.A.type",
            "Minion"
          ],
          [
            "EQUAL",
            "$CARD.sides.A.name",
            "$VILLAIN_NAME"
          ]
        ],
        [
          [
            "MOVE_CARD",
            "$CARD_ID",
            "sharedOutOfPlay",
            -1
          ],
          [
            "SET",
            "/cardById/$CARD_ID/currentSide",
            "A"
          ]
        ]
      ]
    ]
  ],
  [
    "LOG",
    "Setup: Attach \"Hope's Captor\" to the villain"
  ],
  [
    "DEFINE",
    "$CAPTOR",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "e036bd9b-bbba-510c-9f8a-fb35f6ca18af"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$CAPTOR.id",
    "sharedVillain",
    -1
  ],
  [
    "SET",
    "/cardById/$CAPTOR.id/currentSide",
    "A"
  ],
  [
    "LOG",
    "Setup (Gotta Get Away 1B): Each player searches the encounter deck for a Marauder minion and puts it into play engaged with them."
  ]
]