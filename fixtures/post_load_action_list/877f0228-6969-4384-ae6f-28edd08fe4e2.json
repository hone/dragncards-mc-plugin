[
  [
    "LOG",
    "Setup (Vision): Put Just Passing Through side scheme into play"
  ],
  [
    "DEFINE",
    "$JUST_PASSING",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "2bae6c6e-e5cc-535b-8eaf-c16fd89f8d34"
      ]
    ]
  ],
  [
    "COND",
    [
      "DEFINED",
      "$JUST_PASSING"
    ],
    [
      [
        "MOVE_CARD",
        "$JUST_PASSING.id",
        "sharedVillain",
        -1
      ],
      [
        "SET",
        "/cardById/$JUST_PASSING.id/currentSide",
        "A"
      ]
    ]
  ],
  [
    "LOG",
    "Setup (Vision): Attach Dense mass form attachment to Vision"
  ],
  [
    "VAR",
    "$ACTIVE_LEADER_ID",
    "$GAME.groupById.sharedVillain.parentCardIds.[0]"
  ],
  [
    "DEFINE",
    "$DENSE",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "d5d8d1bc-72aa-57a9-9369-4aad56b16f9f"
      ]
    ]
  ],
  [
    "COND",
    [
      "DEFINED",
      "$DENSE"
    ],
    [
      [
        "ATTACH_CARD",
        "$DENSE.id",
        "$ACTIVE_LEADER_ID",
        {
          "combine": "left"
        }
      ],
      [
        "SET",
        "/cardById/$DENSE.id/currentSide",
        "A"
      ],
      [
        "LOG",
        "Setup: Attached Dense to Vision."
      ]
    ]
  ],
  [
    "COND",
    [
      "GREATER_THAN",
      "$GAME.numPlayers",
      1
    ],
    [
      [
        "VAR",
        "$HINDER_THREAT",
        [
          "MULTIPLY",
          2,
          "$GAME.numPlayers"
        ]
      ],
      [
        "VAR",
        "$MAIN_SCHEME_ID",
        "$GAME.groupById.sharedMainScheme.parentCardIds.[0]"
      ],
      [
        "COND",
        [
          "DEFINED",
          "$MAIN_SCHEME_ID"
        ],
        [
          [
            "INCREASE_VAL",
            "/cardById/$MAIN_SCHEME_ID/tokens/threat",
            "$HINDER_THREAT"
          ],
          [
            "LOG",
            "Setup: Added {{$HINDER_THREAT}} hinder threat to main scheme."
          ]
        ]
      ]
    ]
  ],
  [
    "SHUFFLE_GROUP",
    "sharedEncounterDeck"
  ]
]