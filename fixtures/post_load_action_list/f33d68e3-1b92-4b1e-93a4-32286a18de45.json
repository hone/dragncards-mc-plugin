[
  [
    "LOG",
    "Setup: Put \"Kree Command Ship\" into play"
  ],
  [
    "VAR",
    "$ENV_CARD",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "e8c2bd87-310b-5573-a67d-a5617120ee60"
      ]
    ]
  ],
  [
    "COND",
    [
      "DEFINED",
      "$ENV_CARD"
    ],
    [
      [
        "MOVE_CARD",
        "$ENV_CARD.id",
        "sharedVillain",
        -1
      ]
    ]
  ],
  [
    "LOG",
    "Setup: Attach \"Universal Weapon\" to Ronan"
  ],
  [
    "VAR",
    "$ATTACHMENT_CARD",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "a00d6e1b-ebd0-5c8d-9f0f-5bf61e2b4953"
      ]
    ]
  ],
  [
    "COND",
    [
      "DEFINED",
      "$ATTACHMENT_CARD"
    ],
    [
      [
        "MOVE_CARD",
        "$ATTACHMENT_CARD.id",
        "sharedVillain",
        -1
      ]
    ]
  ],
  [
    "LOG",
    "Setup (Ronan 1B): Attach \"Power Stone\" to the 1st player"
  ],
  [
    "VAR",
    "$POWER_STONE_CARD",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "77738a60-281e-5bf9-bc1a-456d2dd4cb69"
      ]
    ]
  ],
  [
    "COND",
    [
      "DEFINED",
      "$POWER_STONE_CARD"
    ],
    [
      [
        "MOVE_CARD",
        "$POWER_STONE_CARD.id",
        "{{$GAME.firstPlayer}}Play1",
        -1
      ],
      [
        "SET",
        "/cardById/$POWER_STONE_CARD.id/currentSide",
        "A"
      ]
    ]
  ],
  [
    "COND",
    [
      "EQUAL",
      "$GAME.mode",
      "expert"
    ],
    [
      [
        "LOG",
        "Setup (Expert): Reveal \"Cut the Power\""
      ],
      [
        "VAR",
        "$SIDE_SCHEME_CARD",
        [
          "ONE_CARD",
          "$CARD",
          [
            "EQUAL",
            "$CARD.databaseId",
            "5e7cfaa7-a4a6-5d1d-9794-40868aa86ffd"
          ]
        ]
      ],
      [
        "COND",
        [
          "DEFINED",
          "$SIDE_SCHEME_CARD"
        ],
        [
          [
            "MOVE_CARD",
            "$SIDE_SCHEME_CARD.id",
            "sharedVillain",
            -1
          ]
        ]
      ]
    ]
  ]
