[
  [
    "LOG",
    "Setup (She-Hulk): Put Legal Practice side scheme into play"
  ],
  [
    "DEFINE",
    "$LEGAL_PRACTICE",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "435af20f-6196-57e8-ac27-43d3d8ba75ca"
      ]
    ]
  ],
  [
    "COND",
    [
      "DEFINED",
      "$LEGAL_PRACTICE"
    ],
    [
      [
        "MOVE_CARD",
        "$LEGAL_PRACTICE.id",
        "sharedVillain",
        -1
      ],
      [
        "SET",
        "/cardById/$LEGAL_PRACTICE.id/currentSide",
        "A"
      ]
    ]
  ],
  [
    "LOG",
    "Setup (She-Hulk): Attach Superhuman Strength to She-Hulk"
  ],
  [
    "VAR",
    "$ACTIVE_LEADER_ID",
    "$GAME.groupById.sharedVillain.parentCardIds.[0]"
  ],
  [
    "DEFINE",
    "$STR",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "18560d4f-a19d-5a68-9eb2-82477eb3d057"
      ]
    ]
  ],
  [
    "COND",
    [
      "DEFINED",
      "$STR"
    ],
    [
      [
        "ATTACH_CARD",
        "$STR.id",
        "$ACTIVE_LEADER_ID",
        {
          "combine": "left"
        }
      ],
      [
        "SET",
        "/cardById/$STR.id/currentSide",
        "A"
      ],
      [
        "LOG",
        "Setup: Attached Superhuman Strength to She-Hulk."
      ]
    ]
  ],
  [
    "COND",
    [
      "GREATER_THAN",
      "$GAME.numPlayers",
      1
    ],
    [
      [
        "VAR",
        "$HINDER_THREAT",
        [
          "MULTIPLY",
          2,
          "$GAME.numPlayers"
        ]
      ],
      [
        "VAR",
        "$MAIN_SCHEME_ID",
        "$GAME.groupById.sharedMainScheme.parentCardIds.[0]"
      ],
      [
        "COND",
        [
          "DEFINED",
          "$MAIN_SCHEME_ID"
        ],
        [
          [
            "INCREASE_VAL",
            "/cardById/$MAIN_SCHEME_ID/tokens/threat",
            "$HINDER_THREAT"
          ],
          [
            "LOG",
            "Setup: Added {{$HINDER_THREAT}} hinder threat to main scheme."
          ]
        ]
      ]
    ]
  ],
  [
    "SHUFFLE_GROUP",
    "sharedEncounterDeck"
  ]
]