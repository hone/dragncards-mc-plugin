[
  [
    "LOG",
    "Setup (Zemo's Manipulations 1A): Place 2 secret counters on each Board Member environment"
  ],
  [
    "FOR_EACH_VAL",
    "$CARD_ID",
    "$GAME.groupById.sharedVillain.parentCardIds",
    [
      [
        "VAR",
        "$CARD",
        "$GAME.cardById.$CARD_ID"
      ],
      [
        "COND",
        [
          "EQUAL",
          "$CARD.sides.A.set",
          "S.H.I.E.L.D. Executive Board"
        ],
        [
          [
            "SET",
            "/cardById/$CARD_ID/tokens/generic",
            2
          ]
        ]
      ]
    ]
  ],
  [
    "LOG",
    "Setup: Set Executive Board Evidence cards aside in Out of Play"
  ],
  [
    "FOR_EACH_VAL",
    "$CARD_ID",
    "$GAME.groupById.sharedEncounterDeck.parentCardIds",
    [
      [
        "VAR",
        "$CARD",
        "$GAME.cardById.$CARD_ID"
      ],
      [
        "COND",
        [
          "EQUAL",
          "$CARD.sides.A.set",
          "Executive Board Evidence"
        ],
        [
          [
            "MOVE_CARD",
            "$CARD_ID",
            "sharedOutOfPlay",
            -1
          ],
          [
            "SET",
            "/cardById/$CARD_ID/currentSide",
            "A"
          ]
        ]
      ]
    ]
  ],
  [
    "SHUFFLE_GROUP",
    "sharedEncounterDeck"
  ]
]