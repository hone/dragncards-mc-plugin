[
  [
    "LOG",
    "Setup: Put Board Member environments into play"
  ],
  [
    "DEFINE",
    "$MED_OFFICER",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "d461d179-8240-5b3f-9160-297b9c035ede"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$MED_OFFICER.id",
    "sharedVillain",
    -1
  ],
  [
    "SET",
    "/cardById/$MED_OFFICER.id/currentSide",
    "A"
  ],
  [
    "DEFINE",
    "$SURV_OFFICER",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "70fd2d4c-f9d7-5014-a5e1-1a38cd4ba0c1"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$SURV_OFFICER.id",
    "sharedVillain",
    -1
  ],
  [
    "SET",
    "/cardById/$SURV_OFFICER.id/currentSide",
    "A"
  ],
  [
    "DEFINE",
    "$TACT_OFFICER",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "54475fb3-bd95-5f7c-beb5-d461508d6e05"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$TACT_OFFICER.id",
    "sharedVillain",
    -1
  ],
  [
    "SET",
    "/cardById/$TACT_OFFICER.id/currentSide",
    "A"
  ],
  [
    "LOG",
    "Setup: Place 2 secret counters on each Board Member environment"
  ],
  [
    "SET",
    "/cardById/$MED_OFFICER.id/tokens/generic",
    2
  ],
  [
    "SET",
    "/cardById/$SURV_OFFICER.id/tokens/generic",
    2
  ],
  [
    "SET",
    "/cardById/$TACT_OFFICER.id/tokens/generic",
    2
  ],
  [
    "LOG",
    "Setup: Set Executive Board Evidence cards aside in Out of Play"
  ],
  [
    "FOR_EACH_VAL",
    "$CARD_ID",
    "$GAME.groupById.sharedEncounterDeck.parentCardIds",
    [
      [
        "VAR",
        "$CARD",
        "$GAME.cardById.$CARD_ID"
      ],
      [
        "COND",
        [
          "EQUAL",
          "$CARD.sides.A.set",
          "Executive Board Evidence"
        ],
        [
          [
            "MOVE_CARD",
            "$CARD_ID",
            "sharedOutOfPlay",
            -1
          ],
          [
            "SET",
            "/cardById/$CARD_ID/currentSide",
            "A"
          ]
        ]
      ]
    ]
  ],
  [
    "SHUFFLE_GROUP",
    "sharedEncounterDeck"
  ]
]