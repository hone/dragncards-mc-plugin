[
  [
    "LOG",
    "Setup: Create Holding Cell deck in secondary deck"
  ],
  [
    "FOR_EACH_VAL",
    "$CARD_ID",
    "$GAME.groupById.sharedEncounterDeck.parentCardIds",
    [
      [
        "VAR",
        "$CARD",
        "$GAME.cardById.$CARD_ID"
      ],
      [
        "COND",
        [
          "IN_STRING",
          "$CARD.sides.A.name",
          "Holding Cell"
        ],
        [
          [
            "MOVE_CARD",
            "$CARD_ID",
            "sharedEncounter2Deck",
            -1
          ],
          [
            "SET",
            "/cardById/$CARD_ID/currentSide",
            "A"
          ]
        ]
      ]
    ]
  ],
  [
    "SHUFFLE_GROUP",
    "sharedEncounter2Deck"
  ],
  [
    "LOG",
    "Setup: Reveal random Adaptoid environment(s) into play"
  ],
  [
    "MOVE_STACKS",
    "sharedEncounter2Deck",
    "sharedVillain",
    1,
    "bottom"
  ],
  [
    "COND",
    [
      "EQUAL",
      "$GAME.mode",
      "expert"
    ],
    [
      [
        "LOG",
        "Setup (Expert Mode): Reveal 2nd Adaptoid environment into play"
      ],
      [
        "MOVE_STACKS",
        "sharedEncounter2Deck",
        "sharedVillain",
        1,
        "bottom"
      ]
    ]
  ],
  [
    "LOG",
    "Setup: Put an Adaptoid minion into play engaged with each player"
  ],
  [
    "FOR_EACH_VAL",
    "$PLAYER_I",
    "$PLAYER_ORDER",
    [
      [
        "DEFINE",
        "$ADAPTOID",
        [
          "ONE_CARD",
          "$CARD",
          [
            "AND",
            [
              "EQUAL",
              "$CARD.groupId",
              "sharedEncounterDeck"
            ],
            [
              "EQUAL",
              "$CARD.databaseId",
              "3754bfa3-f9b2-5dac-a205-5df2ccbf5dab"
            ]
          ]
        ]
      ],
      [
        "COND",
        [
          "DEFINED",
          "$ADAPTOID"
        ],
        [
          [
            "MOVE_CARD",
            "$ADAPTOID.id",
            "{{$PLAYER_I}}Engaged",
            -1
          ],
          [
            "SET",
            "/cardById/$ADAPTOID.id/currentSide",
            "A"
          ],
          [
            "LOG",
            "Setup: Put Adaptoid into play engaged with {{$GAME.playerInfo.$PLAYER_I.alias}}."
          ]
        ]
      ]
    ]
  ],
  [
    "SHUFFLE_GROUP",
    "sharedEncounterDeck"
  ]
]