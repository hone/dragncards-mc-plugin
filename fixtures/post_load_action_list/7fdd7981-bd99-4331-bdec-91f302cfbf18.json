[
  [
    "LOG",
    "Setup (Art Museum Heist): Put 1 random Art attachment into play"
  ],
  [
    "SHUFFLE_GROUP",
    "sharedEncounterDeck"
  ],
  [
    "VAR",
    "$CHOSEN_ART",
    [
      "ONE_CARD",
      "$CARD",
      [
        "AND",
        [
          "EQUAL",
          "$CARD.groupId",
          "sharedEncounterDeck"
        ],
        [
          "IN_STRING",
          "$CARD.sides.A.traits",
          "Art"
        ],
        [
          "EQUAL",
          "$CARD.sides.A.type",
          "Attachment"
        ]
      ]
    ]
  ],
  [
    "COND",
    [
      "DEFINED",
      "$CHOSEN_ART"
    ],
    [
      [
        "MOVE_CARD",
        "$CHOSEN_ART.id",
        "sharedVillain",
        -1
      ],
      [
        "SET",
        "/cardById/$CHOSEN_ART.id/currentSide",
        "A"
      ],
      [
        "LOG",
        "Setup: Put {{$CHOSEN_ART.sides.A.name}} into play."
      ]
    ]
  ],
  [
    "SHUFFLE_GROUP",
    "sharedEncounterDeck"
  ]
]