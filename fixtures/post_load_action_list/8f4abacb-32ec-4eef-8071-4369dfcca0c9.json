[
  [
    "LOG",
    "Setup: Gather and shuffle the four Horsemen villains"
  ],
  [
    "DEFINE",
    "$WAR",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "c65a1044-4033-5737-8b59-80d5bbdff9ce"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$WAR.id",
    "sharedVillainDeck",
    -1
  ],
  [
    "DEFINE",
    "$FAMINE",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "471de767-46ba-5c3b-baaa-101b13022be1"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$FAMINE.id",
    "sharedVillainDeck",
    -1
  ],
  [
    "DEFINE",
    "$PESTILENCE",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "81e18441-008e-5f51-90b8-b0f768ced6b3"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$PESTILENCE.id",
    "sharedVillainDeck",
    -1
  ],
  [
    "DEFINE",
    "$DEATH",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "6940d2fd-b398-5989-8d91-39c0ed0a46ce"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$DEATH.id",
    "sharedVillainDeck",
    -1
  ],
  [
    "COND",
    [
      "EQUAL",
      "$GAME.mode",
      "expert"
    ],
    [
      [
        "FOR_EACH_VAL",
        "$V_ID",
        "$GAME.groupById.sharedVillainDeck.parentCardIds",
        [
          [
            "SET",
            "/cardById/$V_ID/currentSide",
            "B"
          ]
        ]
      ]
    ],
    true,
    [
      [
        "FOR_EACH_VAL",
        "$V_ID",
        "$GAME.groupById.sharedVillainDeck.parentCardIds",
        [
          [
            "SET",
            "/cardById/$V_ID/currentSide",
            "A"
          ]
        ]
      ]
    ]
  ],
  [
    "SHUFFLE_GROUP",
    "sharedVillainDeck"
  ],
  [
    "LOG",
    "Setup: Reveal the four Horsemen villains in a row from left to right"
  ],
  [
    "MOVE_STACKS",
    "sharedVillainDeck",
    "sharedVillain",
    4,
    "bottom"
  ],
  [
    "LOG",
    "Setup: Place active counter on the leftmost Horseman"
  ],
  [
    "VAR",
    "$LEFTMOST_VILLAIN_ID",
    "$GAME.groupById.sharedVillain.parentCardIds.[0]"
  ],
  [
    "SET",
    "/cardById/$LEFTMOST_VILLAIN_ID/tokens/generic",
    1
  ],
  [
    "LOG",
    "Setup: Each player reveals a random side scheme from the Four Horsemen encounter set"
  ],
  [
    "SHUFFLE_GROUP",
    "sharedEncounterDeck"
  ],
  [
    "FOR_EACH_VAL",
    "$PLAYER_I",
    "$PLAYER_ORDER",
    [
      [
        "DEFINE",
        "$HORSEMAN_SCHEME",
        [
          "ONE_CARD",
          "$CARD",
          [
            "AND",
            [
              "EQUAL",
              "$CARD.groupId",
              "sharedEncounterDeck"
            ],
            [
              "EQUAL",
              "$CARD.sides.A.set",
              "Four Horsemen"
            ],
            [
              "EQUAL",
              "$CARD.sides.A.type",
              "Side Scheme"
            ]
          ]
        ]
      ],
      [
        "COND",
        [
          "DEFINED",
          "$HORSEMAN_SCHEME"
        ],
        [
          [
            "MOVE_CARD",
            "$HORSEMAN_SCHEME.id",
            "sharedVillain",
            -1
          ],
          [
            "SET",
            "/cardById/$HORSEMAN_SCHEME.id/currentSide",
            "A"
          ],
          [
            "SET_SCHEME_STARTING_THREAT",
            "$HORSEMAN_SCHEME.id"
          ],
          [
            "LOG",
            "Setup: {{$GAME.playerInfo.$PLAYER_I.alias}} revealed {{$HORSEMAN_SCHEME.sides.A.name}}."
          ]
        ]
      ]
    ]
  ],
  [
    "SHUFFLE_GROUP",
    "sharedEncounterDeck"
  ]
]