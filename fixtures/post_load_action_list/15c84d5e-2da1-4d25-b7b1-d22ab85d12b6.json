[
  [
    "LOG",
    "Setup (Captain America): Put Fearless Determination side scheme into play"
  ],
  [
    "DEFINE",
    "$FEARLESS_DET",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "09170d7c-4530-582b-bae6-0cb0e4e6b861"
      ]
    ]
  ],
  [
    "COND",
    [
      "DEFINED",
      "$FEARLESS_DET"
    ],
    [
      [
        "MOVE_CARD",
        "$FEARLESS_DET.id",
        "sharedVillain",
        -1
      ],
      [
        "SET",
        "/cardById/$FEARLESS_DET.id/currentSide",
        "A"
      ]
    ]
  ],
  [
    "LOG",
    "Setup (Captain America): Attach Cap's Shield to Captain America and give Tough status"
  ],
  [
    "VAR",
    "$ACTIVE_LEADER_ID",
    "$GAME.groupById.sharedVillain.parentCardIds.[0]"
  ],
  [
    "DEFINE",
    "$CAP_SHIELD",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "455469b3-84b3-532e-a4d4-5e7a2b01b76b"
      ]
    ]
  ],
  [
    "COND",
    [
      "DEFINED",
      "$CAP_SHIELD"
    ],
    [
      [
        "ATTACH_CARD",
        "$CAP_SHIELD.id",
        "$ACTIVE_LEADER_ID",
        {
          "combine": "left"
        }
      ],
      [
        "SET",
        "/cardById/$CAP_SHIELD.id/currentSide",
        "A"
      ],
      [
        "SET",
        "/cardById/$ACTIVE_LEADER_ID/tokens/tough",
        1
      ],
      [
        "LOG",
        "Setup: Attached Cap's Shield to Captain America and gave Tough status."
      ]
    ]
  ],
  [
    "COND",
    [
      "GREATER_THAN",
      "$GAME.numPlayers",
      1
    ],
    [
      [
        "VAR",
        "$HINDER_THREAT",
        [
          "MULTIPLY",
          2,
          "$GAME.numPlayers"
        ]
      ],
      [
        "VAR",
        "$MAIN_SCHEME_ID",
        "$GAME.groupById.sharedMainScheme.parentCardIds.[0]"
      ],
      [
        "COND",
        [
          "DEFINED",
          "$MAIN_SCHEME_ID"
        ],
        [
          [
            "INCREASE_VAL",
            "/cardById/$MAIN_SCHEME_ID/tokens/threat",
            "$HINDER_THREAT"
          ],
          [
            "LOG",
            "Setup: Added {{$HINDER_THREAT}} hinder threat to main scheme."
          ]
        ]
      ]
    ]
  ],
  [
    "SHUFFLE_GROUP",
    "sharedEncounterDeck"
  ]
]