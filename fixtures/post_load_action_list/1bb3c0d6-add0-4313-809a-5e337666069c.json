[
  ["LOG", "Setup: Put \"Bell Tower\" into play (Quiet side faceup)"],
  ["DEFINE", "$BELL_TOWER_CARD",
    ["ONE_CARD", "$CARD", ["EQUAL", "$CARD.databaseId", "d2f94480-244a-568c-bcf7-d7cf7815f572"]]
  ],
  ["MOVE_CARD", "$BELL_TOWER_CARD.id", "sharedVillain", -1],
  ["SET", "/cardById/$BELL_TOWER_CARD.id/currentSide", "A"],
  ["COND",
    ["EQUAL", "$GAME.mode", "expert"],
    [
      ["LOG", "Setup (Venom II When Revealed): Reveal \"Tooth and Nail\""],
      ["DEFINE", "$TOOTH_CARD",
        ["ONE_CARD", "$CARD", ["EQUAL", "$CARD.databaseId", "251b6aba-e24a-597f-85a6-4c9063fd418b"]]
      ],
      ["MOVE_CARD", "$TOOTH_CARD.id", "sharedVillain", -1]
    ]
  ]
]
