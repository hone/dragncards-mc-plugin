[
  [
    "LOG",
    "Setup: Attach Juggernaut's Helmet to Juggernaut"
  ],
  [
    "DEFINE",
    "$HELMET",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "cfe0579c-4c74-55c7-a1a4-c53eca37f1dd"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$HELMET.id",
    "sharedVillain",
    -1
  ],
  [
    "SET",
    "/cardById/$HELMET.id/currentSide",
    "A"
  ],
  [
    "COND",
    [
      "EQUAL",
      "$GAME.mode",
      "expert"
    ],
    [
      [
        "LOG",
        "Setup (Juggernaut II When Revealed): Place 1 momentum counter and give Juggernaut a tough status card"
      ],
      [
        "VAR",
        "$JUGGERNAUT_ID",
        "$GAME.groupById.sharedVillain.parentCardIds.[0]"
      ],
      [
        "INCREASE_VAL",
        "/cardById/$JUGGERNAUT_ID/tokens/generic",
        1
      ],
      [
        "SET",
        "/cardById/$JUGGERNAUT_ID/tough",
        true
      ]
    ]
  ]
]