[
  [
    "LOG",
    "Setup (Protection Racket): Shuffle and deal a random player main scheme to each player"
  ],
  [
    "MOVE_STACKS",
    "sharedMainScheme",
    "sharedMainSchemeDeck"
  ],
  [
    "SHUFFLE_GROUP",
    "sharedMainSchemeDeck"
  ],
  [
    "FOR_EACH_VAL",
    "$PLAYER_I",
    "$PLAYER_ORDER",
    [
      [
        "VAR",
        "$SCHEME_ID",
        [
          "GET_CARD_ID",
          "sharedMainSchemeDeck",
          0,
          0
        ]
      ],
      [
        "VAR",
        "$SCHEME",
        "$GAME.cardById.$SCHEME_ID"
      ],
      [
        "COND",
        [
          "DEFINED",
          "$SCHEME"
        ],
        [
          [
            "MOVE_CARD",
            "$SCHEME.id",
            "{{$PLAYER_I}}Engaged",
            0
          ],
          [
            "SET",
            "/cardById/$SCHEME.id/currentSide",
            "B"
          ],
          [
            "SET_SCHEME_STARTING_THREAT",
            "$SCHEME.id"
          ],
          [
            "LOG",
            "Setup: Put {{$SCHEME.sides.B.name}} into play for {{$PLAYER_I}}."
          ]
        ]
      ]
    ]
  ],
  [
    "MOVE_STACKS",
    "sharedMainSchemeDeck",
    "sharedOutOfPlay"
  ],
  [
    "SHUFFLE_GROUP",
    "sharedEncounterDeck"
  ]
]