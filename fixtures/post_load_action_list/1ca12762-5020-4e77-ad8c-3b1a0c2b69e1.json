[
  [
    "LOG",
    "Setup (Iron Man): Put Stark Tower side scheme into play"
  ],
  [
    "DEFINE",
    "$STARK_TOWER",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "f1ac371b-f270-5f2d-9f3c-06502c8524aa"
      ]
    ]
  ],
  [
    "COND",
    [
      "DEFINED",
      "$STARK_TOWER"
    ],
    [
      [
        "MOVE_CARD",
        "$STARK_TOWER.id",
        "sharedVillain",
        -1
      ],
      [
        "SET",
        "/cardById/$STARK_TOWER.id/currentSide",
        "A"
      ]
    ]
  ],
  [
    "LOG",
    "Setup (Iron Man): Attach a random Iron Man Tech attachment to Iron Man"
  ],
  [
    "VAR",
    "$ACTIVE_LEADER_ID",
    "$GAME.groupById.sharedVillain.parentCardIds.[0]"
  ],
  [
    "DEFINE",
    "$TECH_ATT",
    [
      "ONE_CARD",
      "$CARD",
      [
        "AND",
        [
          "EQUAL",
          "$CARD.groupId",
          "sharedEncounterDeck"
        ],
        [
          "IN_STRING",
          "$CARD.sides.A.traits",
          "Tech"
        ],
        [
          "EQUAL",
          "$CARD.sides.A.type",
          "Attachment"
        ]
      ]
    ]
  ],
  [
    "COND",
    [
      "DEFINED",
      "$TECH_ATT"
    ],
    [
      [
        "ATTACH_CARD",
        "$TECH_ATT.id",
        "$ACTIVE_LEADER_ID",
        {
          "combine": "left"
        }
      ],
      [
        "SET",
        "/cardById/$TECH_ATT.id/currentSide",
        "A"
      ],
      [
        "LOG",
        "Setup: Attached {{$TECH_ATT.sides.A.name}} to Iron Man."
      ]
    ]
  ],
  [
    "COND",
    [
      "GREATER_THAN",
      "$GAME.numPlayers",
      1
    ],
    [
      [
        "VAR",
        "$HINDER_THREAT",
        [
          "MULTIPLY",
          2,
          "$GAME.numPlayers"
        ]
      ],
      [
        "VAR",
        "$MAIN_SCHEME_ID",
        "$GAME.groupById.sharedMainScheme.parentCardIds.[0]"
      ],
      [
        "COND",
        [
          "DEFINED",
          "$MAIN_SCHEME_ID"
        ],
        [
          [
            "INCREASE_VAL",
            "/cardById/$MAIN_SCHEME_ID/tokens/threat",
            "$HINDER_THREAT"
          ],
          [
            "LOG",
            "Setup: Added {{$HINDER_THREAT}} hinder threat to main scheme."
          ]
        ]
      ]
    ]
  ],
  [
    "SHUFFLE_GROUP",
    "sharedEncounterDeck"
  ]
]