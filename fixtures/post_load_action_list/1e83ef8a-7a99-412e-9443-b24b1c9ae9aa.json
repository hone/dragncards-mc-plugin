[
  [
    "LOG",
    "Setup: Move Rescued Captive ally to set-aside area"
  ],
  [
    "FOR_EACH_VAL",
    "$CARD_ID",
    "$GAME.groupById.sharedEncounterDeck.parentCardIds",
    [
      [
        "VAR",
        "$CARD",
        "$GAME.cardById.$CARD_ID"
      ],
      [
        "COND",
        [
          "EQUAL",
          "$CARD.databaseId",
          "30d9c2f8-7fa6-5f0b-b51c-cb735f0f465c"
        ],
        [
          [
            "MOVE_CARD",
            "$CARD_ID",
            "sharedOutOfPlay",
            -1
          ],
          [
            "SET",
            "/cardById/$CARD_ID/currentSide",
            "A"
          ]
        ]
      ]
    ]
  ],
  [
    "LOG",
    "Setup: Put Alert Level environment into play (Low side faceup)"
  ],
  [
    "DEFINE",
    "$ALERT",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "048f00d5-1550-5329-9ade-01d4032a479c"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$ALERT.id",
    "sharedVillain",
    -1
  ],
  [
    "SET",
    "/cardById/$ALERT.id/currentSide",
    "A"
  ],
  [
    "COND",
    [
      "EQUAL",
      "$GAME.mode",
      "expert"
    ],
    [
      [
        "LOG",
        "Setup (Expert Mode): Place 2 threat per player on Alert Level"
      ],
      [
        "INCREASE_VAL",
        "/cardById/$ALERT.id/tokens/threat",
        [
          "MULTIPLY",
          2,
          "$GAME.numPlayers"
        ]
      ]
    ]
  ]
]