[
  [
    "LOG",
    "Setup: Put a random Avatar of Loki villain into play"
  ],
  [
    "DEFINE",
    "$AVATAR_1",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "4f7d6486-782d-51fc-9979-942978fe0449"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$AVATAR_1.id",
    "sharedVillainDeck",
    -1
  ],
  [
    "DEFINE",
    "$AVATAR_2",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "5fe063fb-63b4-54cd-88fa-3d393338f174"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$AVATAR_2.id",
    "sharedVillainDeck",
    -1
  ],
  [
    "DEFINE",
    "$AVATAR_3",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "0f5109f5-ef33-5b59-9940-831cd61a17e7"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$AVATAR_3.id",
    "sharedVillainDeck",
    -1
  ],
  [
    "DEFINE",
    "$AVATAR_4",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "1ae6365c-b49c-5935-af7f-f201a3dd3de3"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$AVATAR_4.id",
    "sharedVillainDeck",
    -1
  ],
  [
    "SHUFFLE_GROUP",
    "sharedVillainDeck"
  ],
  [
    "MOVE_STACKS",
    "sharedVillainDeck",
    "sharedVillain",
    1,
    "bottom"
  ],
  [
    "VAR",
    "$ACTIVE_LOKI_ID",
    "$GAME.groupById.sharedVillain.parentCardIds.[0]"
  ],
  [
    "SET",
    "/cardById/$ACTIVE_LOKI_ID/currentSide",
    "A"
  ],
  [
    "SET_VILLAIN_HEALTH",
    "$ACTIVE_LOKI_ID"
  ],
  [
    "LOG",
    "Setup: Revealed {{$GAME.cardById.$ACTIVE_LOKI_ID.sides.A.name}} as active villain."
  ],
  [
    "LOG",
    "Setup: Set remaining Avatar of Loki villains aside in Out of Play"
  ],
  [
    "FOR_EACH_VAL",
    "$LOKI_ID",
    "$GAME.groupById.sharedVillainDeck.parentCardIds",
    [
      [
        "MOVE_CARD",
        "$LOKI_ID",
        "sharedOutOfPlay",
        -1
      ],
      [
        "SET",
        "/cardById/$LOKI_ID/currentSide",
        "A"
      ]
    ]
  ],
  [
    "LOG",
    "Setup: Put each Synergy environment into play"
  ],
  [
    "DEFINE",
    "$DOM",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "1b61b161-11ac-5f05-9c24-5028f7501a8d"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$DOM.id",
    "sharedVillain",
    -1
  ],
  [
    "SET",
    "/cardById/$DOM.id/currentSide",
    "A"
  ],
  [
    "DEFINE",
    "$FEIGN",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "8df6dfd1-c599-5f8a-bc86-3a93fa8d829e"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$FEIGN.id",
    "sharedVillain",
    -1
  ],
  [
    "SET",
    "/cardById/$FEIGN.id/currentSide",
    "A"
  ],
  [
    "DEFINE",
    "$MOUNT",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "30089513-5337-5cbd-ac0b-d36468a88a91"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$MOUNT.id",
    "sharedVillain",
    -1
  ],
  [
    "SET",
    "/cardById/$MOUNT.id/currentSide",
    "A"
  ],
  [
    "DEFINE",
    "$UNIFIED",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "b8487707-d73a-5066-b702-39be14fff1ea"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$UNIFIED.id",
    "sharedVillain",
    -1
  ],
  [
    "SET",
    "/cardById/$UNIFIED.id/currentSide",
    "A"
  ],
  [
    "DEFINE",
    "$FOCUS",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "580c33ac-f966-5dea-8204-633be44d190a"
      ]
    ]
  ],
  [
    "COND",
    [
      "EQUAL",
      "$GAME.mode",
      "expert"
    ],
    [
      [
        "LOG",
        "Setup (Expert Mode): Attach Intense Focus to the Avatar of Loki villain in play"
      ],
      [
        "ATTACH_CARD",
        "$FOCUS.id",
        "$ACTIVE_LOKI_ID",
        {
          "combine": "left"
        }
      ],
      [
        "SET",
        "/cardById/$FOCUS.id/currentSide",
        "A"
      ]
    ],
    true,
    [
      [
        "LOG",
        "Setup (Standard Mode): Set Intense Focus attachment aside in Out of Play"
      ],
      [
        "MOVE_CARD",
        "$FOCUS.id",
        "sharedOutOfPlay",
        -1
      ],
      [
        "SET",
        "/cardById/$FOCUS.id/currentSide",
        "A"
      ]
    ]
  ],
  [
    "SHUFFLE_GROUP",
    "sharedEncounterDeck"
  ]
]