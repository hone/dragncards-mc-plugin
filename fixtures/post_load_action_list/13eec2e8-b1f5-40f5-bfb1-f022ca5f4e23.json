[
  [
    "LOG",
    "Setup: Put Hope Summers into play under the first player's control"
  ],
  [
    "DEFINE",
    "$HOPE",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "e9d08f29-af52-590d-bc2c-37498c3fc919"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$HOPE.id",
    "player1Play1",
    -1
  ],
  [
    "SET",
    "/cardById/$HOPE.id/currentSide",
    "A"
  ],
  [
    "LOG",
    "Setup: Reveal Stryfe's Grasp"
  ],
  [
    "DEFINE",
    "$GRASP",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "2d635edb-9cf2-5af2-bfbd-951756024a76"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$GRASP.id",
    "sharedVillain",
    -1
  ],
  [
    "SET",
    "/cardById/$GRASP.id/currentSide",
    "A"
  ],
  [
    "SET_SCHEME_STARTING_THREAT",
    "$GRASP.id"
  ],
  [
    "COND",
    [
      "EQUAL",
      "$GAME.mode",
      "expert"
    ],
    [
      [
        "LOG",
        "Setup (Stryfe II When Revealed): Discard until a Psionic attachment is found for each player"
      ],
      [
        "FOR_EACH_VAL",
        "$PLAYER_I",
        "$PLAYER_ORDER",
        [
          [
            "DISCARD_UNTIL",
            "sharedEncounterDeck",
            "{{$PLAYER_I}}Play1",
            [
              "POINTER",
              [
                "AND",
                [
                  "EQUAL",
                  "$CARD_ITEM.sides.A.type",
                  "Attachment"
                ],
                [
                  "IN_STRING",
                  "$CARD_ITEM.sides.A.traits",
                  "Psionic"
                ]
              ]
            ]
          ]
        ]
      ]
    ]
  ]
]