[
  [
    "LOG",
    "Setup: Set aside Prelate minions, unused villains, and The Tyrant's Throne"
  ],
  [
    "FOR_EACH_VAL",
    "$CARD_ID",
    "$GAME.groupById.sharedEncounterDeck.parentCardIds",
    [
      [
        "VAR",
        "$CARD",
        "$GAME.cardById.$CARD_ID"
      ],
      [
        "COND",
        [
          "OR",
          [
            "EQUAL",
            "$CARD.sides.A.set",
            "Prelates"
          ],
          [
            "EQUAL",
            "$CARD.databaseId",
            "7f324259-e9ea-5178-909c-b00283c85982"
          ]
        ],
        [
          [
            "MOVE_CARD",
            "$CARD_ID",
            "sharedOutOfPlay",
            -1
          ],
          [
            "SET",
            "/cardById/$CARD_ID/currentSide",
            "A"
          ]
        ]
      ]
    ]
  ],
  [
    "LOG",
    "Setup: Reveal \"Heart of the Empire\" side scheme"
  ],
  [
    "DEFINE",
    "$HEART",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "bf27cf14-f676-5e98-a3df-f323aaa8730c"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$HEART.id",
    "sharedVillain",
    -1
  ],
  [
    "SET",
    "/cardById/$HEART.id/currentSide",
    "A"
  ],
  [
    "SET_SCHEME_STARTING_THREAT",
    "$HEART.id"
  ],
  [
    "LOG",
    "Setup: First player reveals a random set-aside Prelate minion"
  ],
  [
    "DEFINE",
    "$RANDOM_PRELATE",
    [
      "ONE_CARD",
      "$CARD",
      [
        "AND",
        [
          "EQUAL",
          "$CARD.groupId",
          "sharedOutOfPlay"
        ],
        [
          "EQUAL",
          "$CARD.sides.A.set",
          "Prelates"
        ],
        [
          "EQUAL",
          "$CARD.sides.A.type",
          "Minion"
        ]
      ]
    ]
  ],
  [
    "COND",
    [
      "DEFINED",
      "$RANDOM_PRELATE"
    ],
    [
      [
        "MOVE_CARD",
        "$RANDOM_PRELATE.id",
        "player1Engaged",
        -1
      ],
      [
        "SET",
        "/cardById/$RANDOM_PRELATE.id/currentSide",
        "A"
      ],
      [
        "LOG",
        "Setup: First player revealed {{$RANDOM_PRELATE.sides.A.name}}."
      ]
    ]
  ],
  [
    "SHUFFLE_GROUP",
    "sharedEncounterDeck"
  ]
]