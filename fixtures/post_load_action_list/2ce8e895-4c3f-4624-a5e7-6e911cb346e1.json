[
  [
    "LOG",
    "Setup (Stop the Presses!): Put Daily Bugle into play and deal a Daily Bugle support to each player"
  ],
  [
    "VAR",
    "$BUGLE",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "fcf21cf7-fe9c-5f4d-a51d-18982e21cf47"
      ]
    ]
  ],
  [
    "COND",
    [
      "DEFINED",
      "$BUGLE"
    ],
    [
      [
        "MOVE_CARD",
        "$BUGLE.id",
        "sharedVillain",
        -1
      ],
      [
        "SET",
        "/cardById/$BUGLE.id/currentSide",
        "A"
      ]
    ]
  ],
  [
    "FOR_EACH_VAL",
    "$PLAYER_I",
    "$PLAYER_ORDER",
    [
      [
        "VAR",
        "$SUPPORT",
        [
          "ONE_CARD",
          "$CARD",
          [
            "AND",
            [
              "EQUAL",
              "$CARD.groupId",
              "sharedEncounterDeck"
            ],
            [
              "EQUAL",
              "$CARD.sides.A.set",
              "Stop the Presses!"
            ],
            [
              "EQUAL",
              "$CARD.sides.A.type",
              "Support"
            ]
          ]
        ]
      ],
      [
        "COND",
        [
          "DEFINED",
          "$SUPPORT"
        ],
        [
          [
            "MOVE_CARD",
            "$SUPPORT.id",
            "{{$PLAYER_I}}Play1",
            -1
          ],
          [
            "SET",
            "/cardById/$SUPPORT.id/currentSide",
            "A"
          ],
          [
            "LOG",
            "Setup: Put {{$SUPPORT.sides.A.name}} into play for {{$PLAYER_I}}."
          ]
        ]
      ]
    ]
  ],
  [
    "FOR_EACH_VAL",
    "$UNUSED_SUPPORT",
    [
      "FILTER_CARDS",
      "$CARD",
      [
        "AND",
        [
          "EQUAL",
          "$CARD.groupId",
          "sharedEncounterDeck"
        ],
        [
          "EQUAL",
          "$CARD.sides.A.set",
          "Stop the Presses!"
        ],
        [
          "EQUAL",
          "$CARD.sides.A.type",
          "Support"
        ]
      ]
    ],
    [
      [
        "MOVE_CARD",
        "$UNUSED_SUPPORT.id",
        "sharedOutOfPlay",
        -1
      ]
    ]
  ],
  [
    "SHUFFLE_GROUP",
    "sharedEncounterDeck"
  ]
]