[
  [
    "LOG",
    "Setup (Captain Marvel): Put Alpha Flight Station side scheme into play"
  ],
  [
    "DEFINE",
    "$ALPHA_STATION",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "d72669cb-8003-54ac-85ab-0231640c13d6"
      ]
    ]
  ],
  [
    "COND",
    [
      "DEFINED",
      "$ALPHA_STATION"
    ],
    [
      [
        "MOVE_CARD",
        "$ALPHA_STATION.id",
        "sharedVillain",
        -1
      ],
      [
        "SET",
        "/cardById/$ALPHA_STATION.id/currentSide",
        "A"
      ]
    ]
  ],
  [
    "LOG",
    "Setup (Captain Marvel): Attach Energy Channel to Captain Marvel"
  ],
  [
    "VAR",
    "$ACTIVE_LEADER_ID",
    "$GAME.groupById.sharedVillain.parentCardIds.[0]"
  ],
  [
    "DEFINE",
    "$ENERGY_CHANNEL",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "72a50e51-2a62-52c6-852c-b56588df403f"
      ]
    ]
  ],
  [
    "COND",
    [
      "DEFINED",
      "$ENERGY_CHANNEL"
    ],
    [
      [
        "ATTACH_CARD",
        "$ENERGY_CHANNEL.id",
        "$ACTIVE_LEADER_ID",
        {
          "combine": "left"
        }
      ],
      [
        "SET",
        "/cardById/$ENERGY_CHANNEL.id/currentSide",
        "A"
      ],
      [
        "LOG",
        "Setup: Attached Energy Channel to Captain Marvel."
      ]
    ]
  ],
  [
    "COND",
    [
      "GREATER_THAN",
      "$GAME.numPlayers",
      1
    ],
    [
      [
        "VAR",
        "$HINDER_THREAT",
        [
          "MULTIPLY",
          2,
          "$GAME.numPlayers"
        ]
      ],
      [
        "VAR",
        "$MAIN_SCHEME_ID",
        "$GAME.groupById.sharedMainScheme.parentCardIds.[0]"
      ],
      [
        "COND",
        [
          "DEFINED",
          "$MAIN_SCHEME_ID"
        ],
        [
          [
            "INCREASE_VAL",
            "/cardById/$MAIN_SCHEME_ID/tokens/threat",
            "$HINDER_THREAT"
          ],
          [
            "LOG",
            "Setup: Added {{$HINDER_THREAT}} hinder threat to main scheme."
          ]
        ]
      ]
    ]
  ],
  [
    "SHUFFLE_GROUP",
    "sharedEncounterDeck"
  ]
]