[
  [
    "LOG",
    "Setup (The Raft Breakout): Put Master Key into play and reveal a Prisoner minion for each player"
  ],
  [
    "VAR",
    "$MASTER_KEY",
    [
      "ONE_CARD",
      "$CARD",
      [
        "EQUAL",
        "$CARD.databaseId",
        "088ac8d5-ea58-5ce3-95e4-6a9a9e1ad1d6"
      ]
    ]
  ],
  [
    "MOVE_CARD",
    "$MASTER_KEY.id",
    "sharedVillain",
    -1
  ],
  [
    "SET",
    "/cardById/$MASTER_KEY.id/currentSide",
    "A"
  ],
  [
    "LOG",
    "Setup: Put Master Key into play."
  ],
  [
    "FOR_EACH_VAL",
    "$PLAYER_I",
    "$PLAYER_ORDER",
    [
      [
        "DISCARD_UNTIL",
        "sharedEncounterDeck",
        "{{$PLAYER_I}}Engaged",
        [
          "POINTER",
          [
            "AND",
            [
              "EQUAL",
              "$CARD_ITEM.sides.A.type",
              "Minion"
            ],
            [
              "NOT_EQUAL",
              "$CARD_ITEM.sides.A.traits",
              null
            ],
            [
              "IN_STRING",
              "$CARD_ITEM.sides.A.traits",
              "Prisoner"
            ]
          ]
        ]
      ]
    ]
  ],
  [
    "SHUFFLE_GROUP",
    "sharedEncounterDeck"
  ]
]