[
  [
    "LOG",
    "Setup: Set aside Blue Moon, Genosha, and Savage Land encounter sets"
  ],
  [
    "FOR_EACH_VAL",
    "$CARD_ID",
    "$GAME.groupById.sharedEncounterDeck.parentCardIds",
    [
      [
        "VAR",
        "$CARD",
        "$GAME.cardById.$CARD_ID"
      ],
      [
        "COND",
        [
          "OR",
          [
            "EQUAL",
            "$CARD.sides.A.set",
            "Blue Moon"
          ],
          [
            "EQUAL",
            "$CARD.sides.A.set",
            "Genosha"
          ],
          [
            "EQUAL",
            "$CARD.sides.A.set",
            "Savage Land"
          ]
        ],
        [
          [
            "MOVE_CARD",
            "$CARD_ID",
            "sharedOutOfPlay",
            -1
          ],
          [
            "SET",
            "/cardById/$CARD_ID/currentSide",
            "A"
          ]
        ]
      ]
    ]
  ],
  [
    "COND",
    [
      "EQUAL",
      "$GAME.mode",
      "expert"
    ],
    [
      [
        "LOG",
        "Setup (Dark Beast II Expert): Attach High-Tech Goggles to Dark Beast and deal each player an encounter card"
      ],
      [
        "DEFINE",
        "$GOGGLES",
        [
          "ONE_CARD",
          "$CARD",
          [
            "EQUAL",
            "$CARD.databaseId",
            "a677d598-f0bd-520f-ad05-1fe68a6040d0"
          ]
        ]
      ],
      [
        "COND",
        [
          "DEFINED",
          "$GOGGLES"
        ],
        [
          [
            "MOVE_CARD",
            "$GOGGLES.id",
            "sharedVillain",
            -1
          ],
          [
            "SET",
            "/cardById/$GOGGLES.id/currentSide",
            "A"
          ]
        ]
      ],
      [
        "FOR_EACH_VAL",
        "$PLAYER_I",
        "$PLAYER_ORDER",
        [
          [
            "DEAL_ENCOUNTER_CARD",
            false,
            "sharedEncounterDeck",
            "$PLAYER_I"
          ]
        ]
      ]
    ]
  ],
  [
    "PROMPT",
    "$PLAYER_N",
    "darkBeastEnvironmentChoice",
    "$PLAYER_N"
  ]
]