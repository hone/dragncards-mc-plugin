{
  "prompts": {
    "importMc4dbDeck": {
      "args": [],
      "message": "Paste an mc4db deck URL (e.g., https://mc4db.merlindumesnil.net/decklist/view/1)",
      "input": {
        "type": "text"
      },
      "options": [
        {
          "label": "Import Deck",
          "hotkey": "Enter",
          "code": ["ACTION_LIST", "importMc4dbDeck"]
        },
        {
          "label": "Cancel",
          "hotkey": "Escape"
        }
      ]
    },
    "collector2Choice": {
      "args": ["$PLAYER"],
      "message": "Collector II (When Revealed): Choose to either put the top card of your deck into The Collection or take 3 damage.",
      "options": [
        {
          "label": "Put Top Card into The Collection",
          "code": [
            ["DEFINE", "$CARD", "$GAME.groupById.{{$PLAYER}}Deck.parentCards.[0]"],
            ["MOVE_CARD", "$CARD.id", "sharedOutOfPlay", -1],
            ["LOG", "{{$GAME.playerInfo.$PLAYER.alias}} put the top card of their deck into The Collection."]
          ]
        },
        {
          "label": "Take 3 Damage",
          "code": [
            ["DECREASE_VAL", "/playerData/{{$PLAYER}}/hitPoints", 3],
            ["LOG", "{{$GAME.playerInfo.$PLAYER.alias}} took 3 damage from Collector II."]
          ]
        }
      ]
    },
    "discardVictoryChoice": {
      "args": ["$PLAYER", "$CARD_ID"],
      "message": "This card has the Victory keyword. Where would you like to place it?",
      "options": [
        {
          "label": "Victory Display",
          "hotkey": "1",
          "code": [
            ["SET", "/cardById/$CARD_ID/rotation", 0],
            ["SET", "/cardById/$CARD_ID/tokens", {}],
            ["MOVE_CARD", "$CARD_ID", "sharedVictoryDisplay", -1],
            ["LOG", "{{$GAME.playerInfo.$PLAYER.alias}} placed {{$GAME.cardById.$CARD_ID.currentFace.name}} in the Victory Display."]
          ]
        },
        {
          "label": "Discard Pile",
          "hotkey": "2",
          "code": [
            ["VAR", "$DISC_CARD", "$GAME.cardById.$CARD_ID"],
            ["SET", "/cardById/$CARD_ID/rotation", 0],
            ["SET", "/cardById/$CARD_ID/tokens", {}],
            ["MOVE_CARD", "$CARD_ID", "$DISC_CARD.discardGroupId", 0],
            ["LOG", "{{$GAME.playerInfo.$PLAYER.alias}} discarded {{$DISC_CARD.currentFace.name}} to the discard pile."]
          ]
        }
      ]
    },
    "spiralSetupModularChoice": {
      "args": ["$PLAYER"],
      "message": "Spiral requires 3 modular encounter sets from MojoMania to build the Show Deck. How would you like to choose them?",
      "options": [
        {
          "label": "Load 3 Random Modular Sets",
          "hotkey": "R",
          "code": [
            ["ACTION_LIST", "spiralLoadRandomModulars"]
          ]
        },
        {
          "label": "Pick 3 Modular Sets Interactively",
          "hotkey": "P",
          "code": [
            ["PROMPT", "$PLAYER", "spiralPickModular1", "$PLAYER"]
          ]
        },
        {
          "label": "I'll Choose Manually (Stop Setup)",
          "hotkey": "M",
          "code": [
            ["LOG", "Spiral setup: Manual modular selection chosen. Please load 3 modular sets from the menu."]
          ]
        }
      ]
    },
